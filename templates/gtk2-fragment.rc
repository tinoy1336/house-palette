/* GTK2 rc fragment, included by ~/.config/gtkrc.
 *
 * GTK2's rc parser carries no symbolic colour definition, so the palette enters
 * through gtk_color_scheme, the setting GTK2 applications read for their
 * default colours. Every value here is the solid composite of a house role,
 * because GTK2 has no alpha in its colour scheme. */

gtk_color_scheme = "fg_color:{{ink}}
bg_color:{{panel-base.solid}}
base_color:{{view-base}}
text_color:{{ink}}
selected_bg_color:{{accent}}
selected_fg_color:{{ink-on-accent}}
tooltip_bg_color:{{surface-raised}}
tooltip_fg_color:{{ink}}
link_color:{{accent}}
link_visited_color:{{accent-violet}}
error_color:{{error}}
warning_color:{{warning}}"
