# KDE colour sections, staged for a merge into ~/.config/kdeglobals.
#
# The KDE INI format has no include, so this file is a fragment: an apply step
# copies these keys into the live file and leaves every other section
# untouched. Values are R,G,B triples; the format carries no alpha, so each
# one is the solid composite of its role.

[Colors:Window]
BackgroundNormal={{window-base.rgb}}
BackgroundAlternate={{panel-base.rgb}}
ForegroundNormal={{ink.rgb}}
ForegroundInactive={{ink-faint-solid.rgb}}
ForegroundActive={{accent.rgb}}
ForegroundLink={{accent.rgb}}
ForegroundVisited={{accent-violet.rgb}}
ForegroundNegative={{error.rgb}}
ForegroundNeutral={{warning.rgb}}
ForegroundPositive={{success.rgb}}
DecorationFocus={{accent.rgb}}
DecorationHover={{accent-soft.rgb}}

[Colors:View]
BackgroundNormal={{view-base.rgb}}
BackgroundAlternate={{window-base.rgb}}
ForegroundNormal={{ink.rgb}}
ForegroundInactive={{ink-faint-solid.rgb}}
ForegroundActive={{accent.rgb}}
ForegroundLink={{accent.rgb}}
ForegroundVisited={{accent-violet.rgb}}
ForegroundNegative={{error.rgb}}
ForegroundNeutral={{warning.rgb}}
ForegroundPositive={{success.rgb}}
DecorationFocus={{accent.rgb}}
DecorationHover={{accent-soft.rgb}}

[Colors:Button]
BackgroundNormal={{surface-raised.rgb}}
BackgroundAlternate={{window-base.rgb}}
ForegroundNormal={{ink.rgb}}
ForegroundInactive={{ink-faint-solid.rgb}}
ForegroundActive={{ink-emphasis.rgb}}
ForegroundLink={{accent.rgb}}
ForegroundVisited={{accent-violet.rgb}}
ForegroundNegative={{error.rgb}}
ForegroundNeutral={{warning.rgb}}
ForegroundPositive={{success.rgb}}
DecorationFocus={{accent.rgb}}
DecorationHover={{accent-soft.rgb}}

[Colors:Selection]
BackgroundNormal={{accent.rgb}}
BackgroundAlternate={{accent-soft.rgb}}
ForegroundNormal={{ink-on-accent.rgb}}
ForegroundInactive={{ink-secondary.rgb}}
ForegroundActive={{ink-emphasis.rgb}}
ForegroundLink={{ink-on-accent.rgb}}
ForegroundVisited={{ink-secondary.rgb}}
ForegroundNegative={{error.rgb}}
ForegroundNeutral={{warning.rgb}}
ForegroundPositive={{success.rgb}}
DecorationFocus={{accent.rgb}}
DecorationHover={{accent-soft.rgb}}

[Colors:Tooltip]
BackgroundNormal={{surface-raised.rgb}}
BackgroundAlternate={{window-base.rgb}}
ForegroundNormal={{ink.rgb}}
ForegroundInactive={{ink-faint-solid.rgb}}
ForegroundActive={{accent.rgb}}
ForegroundLink={{accent.rgb}}
ForegroundVisited={{accent-violet.rgb}}
ForegroundNegative={{error.rgb}}
ForegroundNeutral={{warning.rgb}}
ForegroundPositive={{success.rgb}}
DecorationFocus={{accent.rgb}}
DecorationHover={{accent-soft.rgb}}

[Colors:Complementary]
BackgroundNormal={{window-base.rgb}}
BackgroundAlternate={{panel-base.rgb}}
ForegroundNormal={{ink.rgb}}
ForegroundInactive={{ink-faint-solid.rgb}}
ForegroundActive={{accent.rgb}}
ForegroundLink={{accent.rgb}}
ForegroundVisited={{accent-violet.rgb}}
ForegroundNegative={{error.rgb}}
ForegroundNeutral={{warning.rgb}}
ForegroundPositive={{success.rgb}}
DecorationFocus={{accent.rgb}}
DecorationHover={{accent-soft.rgb}}
